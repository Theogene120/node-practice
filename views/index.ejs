<!DOCTYPE html>
<html lang="en">
<%- include("./partials/head.ejs") %> <%# Call head %>
<body>
    <%- include("./partials/nav.ejs") %>

    <div class="blogs content">
        <h2>All Blogs</h2>
        <% if(blogs.length > 0) { %>
            <% blogs.forEach(blog => { %>
                <h3><%= blog.title %></h3>
                <p><%= blog.snippet %></p>
            <% }) %>
        <% } else { %>
            <p>Blog not found </p>
        <% } %>
    </div>
</body>
</html>